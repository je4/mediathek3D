<!DOCTYPE html>
<html lang="de" data-theme="mediathek-dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>{{.Title}} - Embed</title>
    <!-- Early theme init script to prevent FOUC -->
    <script src="{{.BaseURL}}static/js/theme-init.js"></script>
    <!-- Tailwind CSS & DaisyUI stylesheets -->
    <link rel="stylesheet" href="{{.BaseURL}}static/css/tailwind.min.css">
    <link rel="stylesheet" href="{{.BaseURL}}static/css/daisyui.min.css">
    <link rel="stylesheet" href="{{.BaseURL}}static/css/daisyui-themes.min.css">
    <link rel="stylesheet" href="{{.BaseURL}}static/scss/mediathek3d.css">
    <!-- HTMX 4 library -->
    <script src="{{.BaseURL}}static/js/htmx-4.0.js"></script>
    <style>
        /* Embed optimizations */
        .brand-section, #cam-json-panel {
            display: none !important;
        }
    </style>
</head>
<body class="embed-mode bg-base-100 text-base-content overflow-hidden select-none">
    <!-- 3D Rendering Canvas Viewport -->
    <div id="renderer-container"></div>

    <!-- UI Overlay HUD -->
    {{template "hud" .}}

    <!-- Help & Navigation Modal -->
    {{template "help_modal" .}}

    <!-- Three.js ES Modules & Import Map -->
    <script type="importmap">
    {
        "imports": {
            "three": "{{.BaseURL}}static/js/three/three.module.js",
            "three/addons/": "{{.BaseURL}}static/js/three/addons/",
            "mediathek-app": "{{.BaseURL}}static/js/mediathek-app.js"
        }
    }
    </script>

    <!-- Mediathek 3D Application Entry Point -->
    <script type="module">
        import { MediathekApp } from 'mediathek-app';

        document.addEventListener('DOMContentLoaded', function () {
            window.mediathekApp = new MediathekApp({
                containerSelector: '#renderer-container',
                floorImage: '{{.BaseURL}}static/img/mt_background.png',
                boxData: '{{.BaseURL}}api/boxes',
                positionsData: '{{.BaseURL}}static/data/kistenpositions.json',
                initialBox: '{{.Box}}',
                initialShelf: '{{.Shelf}}',
                camJSON: {{if .CamJSON}}'{{.CamJSON}}'{{else}}null{{end}},
                isEmbed: true
            });
        });
    </script>
</body>
</html>
